@model IEnumerable<LabSem10DAEA.Models.ProductoModel>

@{
    ViewBag.Title = "Listado de Productos";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>Listado de Productos</h2>
    @Html.ActionLink("Crear Nuevo Producto", "Create", null, new { @class = "btn btn-primary" })
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="width: 80px;">Id</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Descripción</th>
                    <th scope="col" style="width: 140px;">Precio</th>
                    <th scope="col" style="width: 100px;">Stock</th>
                    <th scope="col" class="text-center" style="width: 230px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Id</td>
                            <td>@item.Nombre</td>
                            <td>@item.Descripcion</td>
                            <td>S/. @item.Precio.ToString("N2")</td>
                            <td>
                                <span class="badge @(item.Stock > 5 ? "bg-success" : "bg-warning text-dark")">
                                    @item.Stock unids.
                                </span>
                            </td>
                            <td class="text-center">
                                @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary me-1" })
                                @Html.ActionLink("Detalles", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-info me-1" })
                                @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay productos registrados en la sesión.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
