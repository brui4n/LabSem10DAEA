@model LabSem10DAEA.Models.ProductoModel

@{
    ViewBag.Title = "Registrar Producto";
}

<div class="mt-4 mb-3">
    <h2>Registrar Nuevo Producto</h2>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Datos del Producto</h5>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3 row">
                    @Html.Label("Nombre", "Nombre:", new { @class = "col-sm-2 col-form-label fw-bold" })
                    <div class="col-sm-10">
                        @Html.TextBox("Nombre", null, new { @class = "form-control", placeholder = "Ej: Teclado Mecánico RGB", required = "required" })
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.Label("Descripcion", "Descripción:", new { @class = "col-sm-2 col-form-label fw-bold" })
                    <div class="col-sm-10">
                        @Html.TextArea("Descripcion", null, new { @class = "form-control", rows = 3, placeholder = "Ingrese las características del producto..." })
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.Label("Precio", "Precio (S/.):", new { @class = "col-sm-2 col-form-label fw-bold" })
                    <div class="col-sm-10">
                        @Html.TextBox("Precio", null, new { @class = "form-control", type = "number", step = "0.01", min = "0", placeholder = "0.00", required = "required" })
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.Label("Stock", "Stock:", new { @class = "col-sm-2 col-form-label fw-bold" })
                    <div class="col-sm-10">
                        @Html.TextBox("Stock", null, new { @class = "form-control", type = "number", min = "0", placeholder = "0", required = "required" })
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-sm-10 offset-sm-2">
                        <input type="submit" value="Guardar Producto" class="btn btn-primary" />
                        @Html.ActionLink("Volver a la Lista", "Index", null, new { @class = "btn btn-secondary ms-2" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>
