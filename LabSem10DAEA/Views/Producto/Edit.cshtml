@model LabSem10DAEA.Models.ProductoModel

@{
    ViewBag.Title = "Editar Producto";
}

<div class="mt-4 mb-3">
    <h2>Editar Producto</h2>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">Modificar Datos del Producto: <strong>@Model.Nombre</strong></h5>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.Hidden("Id", Model.Id)

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3 row">
                    @Html.Label("Nombre", "Nombre:", new { @class = "col-sm-2 col-form-label fw-bold" })
                    <div class="col-sm-10">
                        @Html.TextBox("Nombre", Model.Nombre, new { @class = "form-control", required = "required" })
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.Label("Descripcion", "Descripción:", new { @class = "col-sm-2 col-form-label fw-bold" })
                    <div class="col-sm-10">
                        @Html.TextArea("Descripcion", Model.Descripcion, new { @class = "form-control", rows = 3 })
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.Label("Precio", "Precio (S/.):", new { @class = "col-sm-2 col-form-label fw-bold" })
                    <div class="col-sm-10">
                        @Html.TextBox("Precio", Model.Precio, new { @class = "form-control", type = "number", step = "0.01", min = "0", required = "required" })
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.Label("Stock", "Stock:", new { @class = "col-sm-2 col-form-label fw-bold" })
                    <div class="col-sm-10">
                        @Html.TextBox("Stock", Model.Stock, new { @class = "form-control", type = "number", min = "0", required = "required" })
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-sm-10 offset-sm-2">
                        <input type="submit" value="Guardar Cambios" class="btn btn-warning" />
                        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary ms-2" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>
